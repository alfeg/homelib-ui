@model ThinPageModel
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<MyHomeLib.Web.ThinUi> T
@{
    var here = Context.Request.Path + Context.Request.QueryString;
    var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
@*
    Minimal document for e-ink readers: no JavaScript, no external requests, no web fonts.

    The stylesheet is inlined because a second request costs a reader more than these bytes
    do, and a stylesheet that fails to load leaves an unusable page.

    Sizes and greys are set for e-ink, not for the LCD they were first written on. A screen
    that renders in a handful of grey levels turns mid-grey small text into mush: #666 at
    12-13px was legible on a monitor and barely readable on the device. Secondary text is
    now #333 and nothing drops below 14px.

    Markup here is written for humans. Response compression handles the whitespace.
*@
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    @if (Model.AutoRefreshSeconds > 0)
    {
        <meta http-equiv="refresh" content="@Model.AutoRefreshSeconds">
    }
    <title>@Model.Title</title>
    <style>
        * { box-sizing: border-box }

        body {
            font: 17px/1.45 "PT Sans", Tahoma, Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #000;
            background: #fff;
        }

        a { color: #000; text-decoration: none }

        /* e-ink has no hover, so pressed state is an inversion */
        a:active { background: #000; color: #fff }

        .hd { padding: 11px 12px 6px; border-bottom: 3px double #000 }
        .hd h1 { font-size: 21px; margin: 0; font-weight: bold }
        .hd .c { font-size: 17px; color: #333; margin-top: 2px }

        /* The crumbs are the most-used control on the page and were also the smallest
           touch target: inline text with no height of its own. */
        .hd .c a { text-decoration: underline; display: inline-block; padding: 7px 0 }

        .bd { padding: 10px 12px 20px }

        ul { list-style: none; margin: 0; padding: 0 }
        li { border-bottom: 1px solid #999 }

        /* Row-wide tap targets: an inline link is a 17px-tall target on a reader */
        li a { display: block; padding: 10px 0; min-height: 34px }

        .ti { font-size: 18px }
        .m { display: block; color: #333; font-size: 15px; margin-top: 4px }
        .ch { float: right; color: #333 }

        .cap {
            text-transform: uppercase;
            letter-spacing: .08em;
            font-size: 14px;
            color: #333;
            margin: 16px 0 4px;
        }

        form { margin: 0 0 6px }

        input[type=text] {
            width: 100%;
            font-size: 17px;
            font-family: inherit;
            padding: 10px;
            border: 1px solid #000;
            margin: 0 0 8px;
        }

        button {
            font-size: 17px;
            font-family: inherit;
            padding: 10px 22px;
            border: 1px solid #000;
            background: #fff;
        }

        .pg { text-align: center; padding: 16px 0 4px; font-size: 16px; color: #333 }

        .pg a {
            display: inline-block;
            min-width: 66px;
            padding: 10px 14px;
            border: 1px solid #000;
            margin: 0 6px;
            color: #000;
        }

        .d {
            display: block;
            text-align: center;
            padding: 13px;
            border: 2px solid #000;
            margin: 0 0 10px;
            font-size: 17px;
            font-weight: bold;
        }

        .bar { border: 1px solid #000; height: 22px; margin: 10px 0 6px }
        .bar i { display: block; height: 20px; background: #000 }
        .big { font-size: 28px; font-weight: bold; margin: 4px 0 }

        .f { width: 100%; border-collapse: collapse }
        .f tr { border-bottom: 1px solid #999 }

        .f th {
            text-align: left;
            font-weight: normal;
            color: #333;
            font-size: 16px;
            padding: 7px 10px 7px 0;
            width: 45%;
            vertical-align: top;
        }

        .f td { padding: 8px 0; font-size: 16px; vertical-align: top }

        /* Interface language, kept small and out of the way in the header */
        .lang { float: right; font-size: 17px; color: #333 }
        .lang a { text-decoration: underline; margin-left: 10px; display: inline-block; padding: 7px 0 }
        .lang b { margin-left: 10px }
    </style>
</head>
<body>
    <div class="hd">
        <div class="lang">
            @foreach (var (code, label) in new[] { ("ru", "RU"), ("en", "EN") })
            {
                if (string.Equals(code, current, StringComparison.OrdinalIgnoreCase))
                {
                    <b>@label</b>
                }
                else
                {
                    <a href="/m/culture/@code?returnUrl=@Uri.EscapeDataString(here)">@label</a>
                }
            }
        </div>

        <h1>@Model.Heading</h1>

        @if (Model.Crumbs.Count > 0 || !string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <div class="c">
                @for (var i = 0; i < Model.Crumbs.Count; i++)
                {
                    if (i > 0)
                    {
                        <text> · </text>
                    }
                    <a href="@Model.Crumbs[i].Href">@Model.Crumbs[i].Text</a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    if (Model.Crumbs.Count > 0)
                    {
                        <text> · </text>
                    }
                    @Model.Subtitle
                }
            </div>
        }
    </div>

    <div class="bd">
        @if (Model.ShowSearch)
        {
            @await Html.PartialAsync("_SearchForm", ("/m/search", Model.SearchQuery, Model.SearchHidden))
        }

        @RenderBody()
    </div>
</body>
</html>
