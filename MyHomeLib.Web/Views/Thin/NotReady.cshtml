@model NotReadyModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MyHomeLib.Web.ThinUi> T
@*
    First boot takes minutes, so the wait is made legible: a progress bar plus a meta
    refresh set on the layout. The browser does the polling; no script is served.
*@
@if (Model.Failed)
{
    <p class="m">@Model.Status.Error</p>
    <p class="m">@T["Check the server log. The page will not refresh by itself."]</p>

    <a href="/m" class="d">@T["Try again"]</a>
}
else
{
    <div class="big">@Model.Status.Percent%</div>

    <div class="bar">
        <i style="width:@(Model.Status.Percent)%"></i>
    </div>

    <p class="m">@Model.Status.Message</p>

    <div class="cap">@T["Status"]</div>

    <table class="f">
        <tr>
            <th>@T["Phase"]</th>
            <td>@Model.Status.Phase</td>
        </tr>
        <tr>
            <th>@T["Refreshing"]</th>
            <td>@T["every {0} s", Model.RefreshSeconds]</td>
        </tr>
    </table>
}
