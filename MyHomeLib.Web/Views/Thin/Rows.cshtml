@model RowsModel

@if (Model.Leading.Count > 0)
{
    @if (Model.LeadingCaption is not null)
    {
        <div class="cap">@Model.LeadingCaption</div>
    }
    @await Html.PartialAsync("_Rows", Model.Leading)
}

@if (Model.Caption is not null)
{
    <div class="cap">@Model.Caption</div>
}

@await Html.PartialAsync("_Rows", Model.Rows)
@await Html.PartialAsync("_Pager", (Model.PreviousHref, Model.NextHref, Model.PagerCaption))
