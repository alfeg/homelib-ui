# Copy to .env and fill in. The instance serves exactly this one library —
# clients cannot supply a magnet URI.
LIBRARY_MAGNET_URI=magnet:?xt=urn:btih:...
LIBRARY_TITLE=MyHomeLib

# Optional iroh tunnel for the PocketBook app (docker compose --profile iroh). See tunnel/README.md.
#HOMELIB_GATE_SECRET=        # docker run --rm ghcr.io/alfeg/homelib-gate keygen
#HOMELIB_TUNNEL_TOKEN=       # same value as the relay's IROH_RELAY_ACCESS_TOKEN
#HOMELIB_RELAY_URL=http://relay.example.net:3340
#HOMELIB_GATE_PORT=11204
#HOMELIB_GATE_DIRECT=192.168.1.10:11204   # this machine's LAN IP, for direct connections at home

# At least 16 bytes (Meilisearch refuses shorter keys when MEILI_ENV=production).
MEILI_MASTER_KEY=change-me-to-16-plus-bytes
