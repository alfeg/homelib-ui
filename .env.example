# Copy to .env and fill in. The instance serves exactly this one library —
# clients cannot supply a magnet URI.
LIBRARY_MAGNET_URI=magnet:?xt=urn:btih:...
LIBRARY_TITLE=MyHomeLib

# At least 16 bytes (Meilisearch refuses shorter keys when MEILI_ENV=production).
MEILI_MASTER_KEY=change-me-to-16-plus-bytes
