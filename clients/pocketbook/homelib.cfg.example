# HomeLib for PocketBook — copy to applications/homelib.cfg on the reader.

# The shared ticket from the server owner (`docker compose run --rm iroh-gate ticket`).
# Treat it like a password: whoever has it can use the library.
ticket=homelib2:<endpoint id>:<token>:http://relay.example.net:3340/#192.168.1.10:11204

# Where downloaded books go. The reader's library picks them up from there.
#download_dir=/mnt/ext1/HomeLib

# Fonts (file names without extension). By default the app picks Literata if present.
#font=Literata-Regular
#font_bold=Literata-Bold
